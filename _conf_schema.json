{
  "llm_wake_patterns": {
    "description": "LLM 唤醒词列表",
    "type": "list",
    "hint": "当消息包含这些词时，会触发 LLM 回复（正则表达式格式）",
    "default": [
      "[?？]",
      "怎么",
      "如何",
      "为什么",
      "什么是",
      "是什么",
      "能不能",
      "可不可以",
      "帮我",
      "请问",
      "告诉我",
      "解释",
      "说说",
      "介绍",
      "推荐",
      "建议",
      "分析",
      "总结",
      "翻译",
      "写一",
      "帮忙",
      "教我",
      "怎样",
      "哪个",
      "哪些",
      "多少",
      "几个",
      "有没有",
      "是否",
      "能否",
      "可以吗",
      "行吗",
      "好吗",
      "对吗",
      "吗$"
    ]
  },
  "wake_word_prefix": {
    "description": "唤醒词前缀",
    "type": "string",
    "hint": "以此字符开头的消息只触发玩梗，不触发 LLM（默认为 /）",
    "default": "/"
  },
  "require_prefix": {
    "description": "需要前缀才触发语音",
    "type": "bool",
    "hint": "开启后，消息必须以唤醒词前缀开头才会触发语音识别回复（如 /曹操3），关闭则任意消息均可触发",
    "default": false
  },
  "enable_group_only": {
    "description": "仅群聊触发",
    "type": "bool",
    "hint": "是否只在群聊中触发玩梗功能",
    "default": true
  },
  "private_chat_llm_mode": {
    "description": "私聊 LLM 回复模式",
    "type": "string",
    "hint": "私聊时的 LLM 回复行为：always=总是回复, smart=智能判断, never=从不回复",
    "default": "smart",
    "options": ["always", "smart", "never"]
  },
  "fuzzy_threshold": {
    "description": "相似度阈值",
    "type": "float",
    "hint": "关键词模糊匹配的灵敏度（0-1，默认 0.6，越高越严格）",
    "default": 0.6
  }
}
